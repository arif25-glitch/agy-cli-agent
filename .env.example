# ==========================================
# Gemini-Hermes Environment Configuration
# ==========================================

# 1. Telegram Bot Token from @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# 2. Your Telegram User ID (get it from @userinfobot or @raw_data_bot on Telegram)
# Comma-separated list of allowed numerical IDs.
# If left empty, all users will be able to access the bot (not recommended for server security).
TELEGRAM_ALLOWED_USERS=

# 3. Antigravity CLI Proxy Forwarder Settings
AGY_BIN=/root/.local/bin/agy
REASONING_EFFORT=medium
STREAM_UPDATES=true
STREAM_EDIT_INTERVAL=1.2
DANGEROUSLY_SKIP_PERMISSIONS=true
WORKSPACE_DIR=/gemini-hermes
